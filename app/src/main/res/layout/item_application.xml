<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Ligne 1 : Titre + Badge statut + Corbeille -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="10dp">

            <!-- Titre -->
            <TextView
                android:id="@+id/application_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Titre du poste"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#1976D2"
                android:maxLines="2"
                android:ellipsize="end"
                android:layout_marginEnd="8dp" />

            <!-- Badge statut -->
            <TextView
                android:id="@+id/application_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="En attente"
                android:textSize="12sp"
                android:textColor="#FF9800"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"
                android:background="@drawable/badge_waiting" />

            <!-- Bouton Supprimer (corbeille) -->
            <ImageButton
                android:id="@+id/delete_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@android:drawable/ic_menu_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="#E53935"
                android:contentDescription="Supprimer la candidature"
                android:padding="4dp" />

        </LinearLayout>

        <!-- Entreprise -->
        <TextView
            android:id="@+id/application_company"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🏢 Entreprise"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorPrimary"
            android:layout_marginBottom="4dp" />

        <!-- Localisation -->
        <TextView
            android:id="@+id/application_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📍 Localisation"
            android:textSize="14sp"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginBottom="6dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0F0F0"
            android:layout_marginBottom="8dp" />

        <!-- Date -->
        <TextView
            android:id="@+id/application_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📅 Postulé le : --"
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary" />

    </LinearLayout>

</androidx.cardview.widget.CardView>

